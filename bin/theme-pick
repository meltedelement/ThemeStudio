#!/usr/bin/env bash
# /* ---- 💫 theme-pick (Super+T) 💫 ---- */
# Rofi menu of the theme bundles in ~/.config/hypr/themes; applies the choice with theme-apply.
# Thumbnails are generated by Theme Studio into ~/.cache/themestudio/picker/.

set -euo pipefail

THEMES_DIR="$HOME/.config/hypr/themes"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/themestudio"
HERE="$(dirname "$(readlink -f "$0")")"

notify() { command -v notify-send >/dev/null 2>&1 && notify-send -a ThemeStudio "$1" "$2" || true; }

if [[ ! -d "$THEMES_DIR" ]] || [[ -z "$(find "$THEMES_DIR" -maxdepth 1 -name '*.theme' -print -quit)" ]]; then
  notify "No theme bundles found" "Create one with Theme Studio"
  exit 0
fi

current="$(cat "$CACHE_DIR/current" 2>/dev/null || true)"

files=()
menu=""
selected_row=0
for f in "$THEMES_DIR"/*.theme; do
  [[ -f "$f" ]] || continue
  slug="$(basename "$f" .theme)"
  display_name="$(grep -E '^NAME=' "$f" | head -n1 | sed -E 's/^NAME="?([^"]*)"?$/\1/')"
  [[ -n "$display_name" ]] || display_name="$slug"
  [[ "$slug" == "$current" ]] && selected_row=${#files[@]}
  files+=("$f")
  thumb="$CACHE_DIR/picker/$slug.png"
  if [[ -f "$thumb" ]]; then
    menu+="$display_name"$'\0icon\x1f'"$thumb"$'\n'
  else
    menu+="$display_name"$'\n'
  fi
done

set +e
idx="$(printf '%s' "$menu" | rofi -dmenu -i -show-icons -format i -selected-row "$selected_row" -p 'Select Theme')"
prompt_status=$?
set -e

if (( prompt_status != 0 )) || [[ -z "$idx" ]]; then
  exit 0
fi

exec "$HERE/theme-apply" "${files[$idx]}"
